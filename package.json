{
  "name": "roomjoy",
  "version": "0.2.0",
  "private": true,
  "description": "RoomJoy \u2014 Good company. Clever games. TV+phone multiplayer.",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @roomjoy/server --filter @roomjoy/web run dev",
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** run build",
    "test": "pnpm --filter @roomjoy/server run test",
    "lint": "echo \"No lint configured for M2\""
  },
  "devDependencies": {
    "typescript": "5.7.2"
  }
}
