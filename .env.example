# Server
PORT=2567
HOST=0.0.0.0
NODE_ENV=development

# Public URL used in QR join links (TV display). Override in production.
PUBLIC_WEB_URL=http://localhost:5173

# Web (Vite) — set at build time for production
VITE_SERVER_URL=ws://localhost:2567
VITE_PUBLIC_WEB_URL=http://localhost:5173

# Production VPS examples:
# HOST=127.0.0.1
# NODE_ENV=production
# PUBLIC_WEB_URL=https://play.example.com
# VITE_SERVER_URL=wss://api.example.com
# VITE_PUBLIC_WEB_URL=https://play.example.com
